{
  "name": "search-pipeline-tracker-app",
  "productName": "Job Search Tracker",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning scripts/start.mjs",
